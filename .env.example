# Base URL of Rightmo-Product-Backend-API (Docker nginx, see its compose.yaml), including the version prefix
NEXT_PUBLIC_API_BASE_URL=http://localhost:8089/api/v1

# Request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000

# Symbol shown before prices
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs.

# Time zone used to display dates (same on server and browser)
NEXT_PUBLIC_TIME_ZONE=Asia/Colombo

# Optional, server-only: address Next.js uses to reach the API during SSR
# (e.g. http://nginx/api/v1 when both run in Docker). Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_URL=
